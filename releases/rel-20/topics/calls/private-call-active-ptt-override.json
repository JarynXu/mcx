  "common_conditions": [
    "3GPP TS 22.179 V20.0.0，Release 20，Stage 1，第 6 章在网。本页主查 §6.7.1-010 的同一 MCPTT 私呼，不把它套到离网、组呼或第三方互通。§6.7.0 及 -001 涵盖有和无话权私呼；-010 本句未标话权类型，不据此判任一类型保证、两类机制相同或只有一类适用。"
  ],
  "condition_rule": "Inherit common_conditions and add claim conditions.",
