    {
      "id": "floor-controlled-emergency-private-call-ranks-over-other-mcptt-private-calls",
      "clause": "6.8.7.2",
      "requirements": [
        "R-6.8.7.2-001"
      ],
      "conditions": [
        "在网带话权 MCPTT 紧急私呼。所查比较对象是其他 MCPTT 私呼，不是全业务的呼叫类型排序。"
      ],
      "conclusion": "服务须保证该类带话权紧急私呼相对所有其他 MCPTT 私呼处在最高优先级。不是对两通同类带话权紧急私呼的裁决，也不单据本条给组呼或系统呼叫排名，不等于已经抢占。跨呼叫类型的抢占优先级另按 R-6.8.7.2-004 的对象和例外核。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.179-v20.0.0",
          "clauses": [
            "6.8.7.2"
          ],
