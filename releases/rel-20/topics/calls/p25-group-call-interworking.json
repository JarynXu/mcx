    {
      "id": "emergency-group-call-to-p25-emergency-call-interop-not-emergency-state",
      "clause": "6.18.3.2",
      "requirements": [
        "R-6.18.3.2-004"
      ],
      "conditions": [
        "比较 P25 与 MCPTT 在网应急通话互通；不是仅已接上普通组呼。"
      ],
      "conclusion": "须支持 MCPTT 应急组呼与 P25 应急呼叫互通。原文没有把 P25 一侧写成某种特定的应急组呼，也没有规定逐次优先级、发起方向、个人紧急告警、用户或组状态转换。普通组呼互通不证明此次应急互通。",
      "source_references": [
