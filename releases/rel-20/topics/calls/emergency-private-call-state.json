    {
      "id": "group-in-progress-emergency-begins-with-emergency-group-call-in-overview",
      "clause": "5.7.1",
      "conditions": [
        "核对一组的 In-progress Emergency 状态，而非某一用户或私呼。"
      ],
      "conclusion": "§3.1 将其定义为已被服务接受且未被获授权用户取消的组紧急状态。§5.7.1 概述把开始紧急组呼描述为该状态的起点；状态仍在时，组成员随后在该组发起的组呼按紧急组呼处理。当该组状态取消时移除组的紧急优先级；不从用户状态或私呼优先级单独推定这个动作。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.179-v20.0.0",
          "clauses": [
