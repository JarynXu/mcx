    {
      "id": "administrator-and-floor-control-single-request-limit",
      "clause": "6.2.3.5",
      "requirements": [
        "R-6.2.3.5-001",
        "R-6.2.3.5-002"
      ],
      "conditions": [
        "核对单次发话申请对应的发话时长上限。"
      ],
      "conclusion": "服务须使管理员能设定一次发话申请对应的发话时长上限，话权控制功能须有可配置的这项上限。不是整通呼叫或累计若干次申请的时长；本节未规定默认值、单位、开始计时的协议事件或达到上限前提示的配置者。",
