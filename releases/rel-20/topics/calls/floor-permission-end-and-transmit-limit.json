      "id": "authorized-user-can-terminate-active-talkers-permission",
      "clause": "6.2.3.4",
      "requirements": [
        "R-6.2.3.4-001"
      ],
      "conditions": [
        "核对 MCPTT 服务须提供给获授权用户的能力，目标是正在发话参与者的发话许可。"
      ],
      "conclusion": "服务须允许获授权的 MCPTT 用户随时终止该许可。授权不是特定职称或必须为其他用户；也不以先有志愿停话、发话到期为前提。服务支持能力不证明实际执行、撤权通知已到或会话结束。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.179-v20.0.0",
          "clauses": [
            "6.2.3.4"
          ],
