    {
      "id": "service-enables-administrator-to-configure-user-interaction",
      "clause": "6.17",
      "requirements": [
        "R-6.17-002"
      ],
      "conditions": [
        "在网 MCPTT 用户的电话呼叫与 MCPTT 呼叫之间的互动配置。"
      ],
      "conclusion": "MCPTT 服务须提供机制，供 MCPTT 管理员为某个 MCPTT 用户配置电话呼叫与 MCPTT 呼叫的互动。角色是 MCPTT 管理员，配置对象是 MCPTT 用户的这两类呼叫。它不等同于让普通用户自行操作，不给 UI、按组或全局策略层级及配置载体。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.179-v20.0.0",
          "clauses": [
            "6.17"
          ],
          "printed_pages": [
            57
          ],
          "requirements": [
            "R-6.17-002"
          ]
        }
      ]
    },
    {
      "id": "configuration-availability-is-not-effective-policy-or-actual-outcome",
      "clause": "6.17",
      "requirements": [
        "R-6.17-002"
      ],
      "conditions": [
        "要判断某一 MCPTT 用户遇到电话和 MCPTT 呼叫并存或冲突时的实际结果。"
      ],
      "conclusion": "该条只要求配置能力，未规定哪个方向由哪边打断、暂停、并行或默认顺序。没有本用户的生效策略或事件记录就不能据此判运行结果；只有策略不证明发生，只有中断或并行观测不证明原因。若同一用户生效策略与该次记录的判定及实效可对应，可确认这一例的处置，不能外推默认或另一方向。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.179-v20.0.0",
          "clauses": [
            "6.17"
          ],
          "printed_pages": [
