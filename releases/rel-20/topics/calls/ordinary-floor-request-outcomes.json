      "clause": "6.2.3.2",
      "requirements": [
        "R-6.2.3.2-003"
      ],
      "conditions": [
        "同一 MCPTT 呼叫出现同时发话申请。"
      ],
      "conclusion": "话权控制须确定实际发话的参与者。本条没有指定哪一次申请赢、并列顺序或算法。不同呼叫的并发不是这条；不要套插话组的最新请求规则。",
      "source_references": [
