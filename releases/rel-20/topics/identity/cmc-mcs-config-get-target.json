    {
      "id": "document-get-gc-and-cmc",
      "clause": "6.3.3.2.1",
      "conditions": [
        "整份配置文档读取，检查通用 GC 程序或 CMC 所用的发送程序。"
      ],
      "conclusion": "GC 须发 HTTP GET，并用 Request-URI 引用文档，指向 RFC 4825 Retrieve a Document。保留 document to be updated 的字样；本段的动作仍是取文 GET，不是 PUT 更新。CMC 执行该 GC 程序处理同一笔请求，不另要求一个 GC 节点先发；原文写设置到按 TS 24.483 配置的 CMSXCAPRootURI 并带相应用法的 auid。不能从根加 auid 得出完整目标地址。",
      "source_references": [
