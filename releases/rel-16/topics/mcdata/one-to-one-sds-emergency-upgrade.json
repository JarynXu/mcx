  "common_conditions": [
    "Release 16，在网一对一 SDS 的升级程序；两名参与者属于同一 MCData 系统，发起升级者有相应授权。",
    "一对一 SDS 通信已按 §7.4.2.3 建立为媒体面独立传送或按 §7.4.2.4 建立为会话，并且仍在进行。"
  ],
  "condition_rule": "既有通信与用户资格是范围条件，并非用户已经发起紧急事件。甲、乙分别指发起侧和接收侧；能否登记一次动作，须看记录实际到哪一步。",
  "claims": [
    {
      "id": "oto-sds-up-scope",
      "title": "本在网一对一 SDS 紧急升级程序适用于获授权用户、双方同系统，且媒体面独立 SDS 或一对一 SDS 会话已按所引程序建立并仍在进行的情形",
      "conditions": [
        "判断一份通信记录是否落入本程序。"
      ],
      "conclusion": "两种起点分别是按 §7.4.2.3 建立的媒体面独立一对一 SDS 和按 §7.4.2.4 建立的一对一 SDS 会话。仅有建会请求不能证明已经建立；仅走信令控制面的独立传送不属于这两个起点。",
      "normative_strength": "这是本程序的适用范围，不是所有系统的功能限制。",
      "limitations": [
        "具备这些条件不证明用户已实际发起升级。跨系统、仅走信令面等情况不适用本程序，不等于技术上不支持紧急通信。"
      ],
