  "claims": [
    {
      "id": "store-fd4-file-transfer",
      "title": "MCData-FD-4：终端媒体存储客户端通过 HTTP 向内容服务器的媒体存储功能上传文件或从中下载文件",
      "conditions": [
        "在文件分发中，交互一端是终端的媒体存储客户端，另一端是内容服务器的媒体存储功能。"
      ],
      "conclusion": "该参考点承载上述文件上传或下载。若记录只证明甲端上传成功，能确认的是这次上传，不能用它证明乙已下载同一文件。",
      "normative_strength": "功能及参考点用途；成功与否按给定的具体记录判断。",
      "limitations": [
        "终端上传不是业务服务器为组播取件；只有 HTTP 和文件名，不能确定哪一方在取件。"
      ],
