  "common_conditions": [
    "在网 MCData 组通信。被引用的升级或取消示例中，该组已在组管理服务器定义，示例三端均已归属，全部组员同属一个 MCData 系统，操作用户获相应授权。"
  ],
  "condition_rule": "每条声明继承共同的组和系统场景，再采用自己的业务、动作及示例前提。升级的建立方式限制不独立改写为取消条款的明文前提；示例三端并非固定人数门槛。",
  "claims": [
    {
      "id": "grp-ip-sds-upgrade",
      "title": "组 SDS 按 §7.4.2.11.2 升为迫近危险：本程序仅适用于已建立且进行中的媒体面独立组 SDS 或组 SDS 会话；引用组 SDS 紧急升级，步骤 5 通知用户组状态",
      "conditions": [
        "既有通信已按 §7.4.2.6 建立为媒体面独立组 SDS 或按 §7.4.2.7 建立为组 SDS 会话，通信正在进行；被引用紧急升级示例中的发起端已配置为在紧急升级时发告警。"
      ],
      "conclusion": "§7.4.2.11.2 引用 §7.4.2.9。步骤 2 客户端 1 在给服务器的升级请求中设置迫近危险指示；步骤 5 用户获知组正处于迫近危险状态。",
      "normative_strength": "条款限定两种已建立的通信，要求支持所引程序和信息流，并明列两项澄清。",
      "limitations": [
        "仅走信令控制面的独立组 SDS 不在该升级起点内；发出建会请求不是已建立，符合场景也不是实际升级、告警送达或短消息交付。"
      ],
