  "common_conditions": [
    "Release 16，Stage 3；本文选取普通在网、按需建立的 MCPTT 聊天组呼。",
    "从该组会话的控制 MCPTT 功能看参与者一侧的退出、控制功能主动移出一人和整场释放。"
  ],
  "condition_rule": "先分别识别来向 BYE、主动移出、须整场释放；通知还受该分支的条件与会议订阅范围限制。",
  "claims": [
    {
      "id": "chat-incoming-bye-leg",
      "title": "普通在网 MCPTT 按需聊天组的控制功能对参与者一侧的 BYE 回 200 后，还须判断是否释放整场",
      "conditions": [
        "控制功能收到一名参与者一侧的 SIP BYE。"
      ],
      "conclusion": "先与媒体面交互释放该客户端这一侧的关联媒体资源，并朝该侧回 200；检查组呼释放策略，决定是否还需释放整个组会话。",
      "normative_strength": "本入口的媒体处理、应答和策略检查均为须执行的动作。",
      "limitations": [
        "本条 200 是对收到的 BYE 作答，不能证明其他参与者收到 BYE 或全场已结束。"
      ],
