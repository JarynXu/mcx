  "common_conditions": [
    "Rel-16 TS 24.379 V16.14.0 中普通在网 MCPTT 私呼回电的客户端流程；甲为请求回电的用户，乙为回电目标用户。"
  ],
  "condition_rule": "发起、确认、取消、失败和履约是不同事件；各条分别满足对应的角色、标识与本地状态，不以两端均成功为共同前提。",
  "claims": [
    {
      "id": "request-and-cancel-permissions",
      "title": "发起和取消分别受本机配置许可约束",
      "conditions": [
        "甲用户请求发起回电或取消回电；分别判断本次操作。"
      ],
      "conclusion": "甲端检查用户配置 ruleset 中本次操作的许可。allow-request-private-call-call-back 或 allow-cancel-private-call-call-back 中对应项缺失或为 false，就告知用户并退出该操作；授权通过才生成 SIP MESSAGE。",
      "normative_strength": "§11.1.5.2.1 的条件性 SHALL。",
      "limitations": [
        "允许发起不能推出允许取消；本机许可也不是对端已确认。"
      ],
      "source_references": [
