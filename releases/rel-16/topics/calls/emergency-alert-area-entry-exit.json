    {
      "id": "individual-alert-versus-group-emergency-state",
      "title": "取消本人的告警与结束全组紧急状态分开判断",
      "conditions": [
        "用户在离区后选择另行发起取消；若还要求结束全组正在进行的紧急状态，再分别判断两个请求。"
      ],
      "conclusion": "取消自己的告警是向先前的告警组通报本人警情结束；如果还请求取消全组正在进行的紧急状态，服务器可对两者分别接受或拒绝。",
      "normative_strength": "§10.10.1.2.4 步骤 5 为可选转入；§10.10.1.2.2 注 2 说明两项判断独立。",
      "limitations": [
