  "claims": [
    {
      "id": "reject-media-or-service",
      "title": "并接已有预安排组呼时，媒体参数不可接受或未提供 MCPTT 语音编解码器应拒绝（488）；媒体检查通过后，任一规定业务标签缺失或 ICSI 值不符应拒绝（403）",
      "conditions": [
        "组成组非控制功能收到给本功能的组级邀请，且本组已有预安排组呼。"
      ],
      "conclusion": "先检查媒体参数及所提供的编解码器。通过后再检查是否同时具备 MCPTT 媒体特性标签及标识 MCPTT 业务的 ICSI 引用标签。",
      "normative_strength": "两类检查依次进行，失败时按该项拒绝，不继续并接。",
      "limitations": [
        "不是对单个客户端重入的准入规则。"
      ],
