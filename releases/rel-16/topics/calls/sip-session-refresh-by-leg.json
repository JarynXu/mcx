{
  "topic_id": "r16-calls-sip-session-refresh-by-leg",
  "release": 16,
  "standard_stage": 3,
  "state": "draft",
  "title": "MCPTT 按需私呼的 SIP 会话刷新：哪一段由谁刷新？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-24.379-v16.14.0",
  "condition_rule": "每条 claim 继承所有 common_conditions，并叠加自身 conditions。只有明列对照时才离开普通按需私呼场景。",
  "common_conditions": [
    "Release 16、Stage 3；依据 TS 24.379 V16.14.0。",
    "除明列的普通在网按需聊天组对照外，仅普通在网、单被叫、带话权控制的按需 MCPTT 私呼；双方不复用预建立会话。",
    "信令条款只涉及初始 INVITE 及其最终 200；不用于 PRACK、UPDATE、re-INVITE 或 REFER 的应答。业务计时器单列。"
  ],
  "claims": [
    {
      "id": "r16-calls-sip-session-refresh-pf-defaults",
      "title": "两侧参与功能的最终响应头相同，省略时的刷新方不同",
      "conditions": [
        "发起侧参与功能或终接侧参与功能按本页适用的按需程序，为本段收到的初始 INVITE 生成最终 200。"
      ],
      "conclusion": "两侧参与功能的最终 200 都必须带 Require: timer 和 Session-Expires。若本段来向 INVITE 未带 refresher，发起侧参与功能回 uac，指主叫终端；终接侧参与功能回 uas，指它自身。",
      "normative_strength": "响应头强制；来向未带 refresher 时的填值强制。",
      "limitations": [
        "来向显式带参数不免除响应头要求，但不套省略时的取值。两条 helper 都引用 RFC 4028 的 UAS 规则；本条不规定显式值下一定回什么。"
      ],
