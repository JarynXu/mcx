  "common_conditions": [
    "3GPP TS 23.281 V16.4.0（Release 16，Stage 2），在网一对一视频拉取，主叫甲请求被叫乙向甲提供视频。"
  ],
  "condition_rule": "以在网一对一拉取为主；区分建呼授权、可选进展、被叫接受和传输完成各自的条件。相邻流程是阅读路标。",
  "claims": [
    {
      "id": "select-user-pull-direction",
      "title": "主叫发起拉取，只有被叫可向主叫发送视频",
      "conditions": [
        "甲发起在网一对一私呼，要从被邀请的 MCVideo 用户乙处获取视频。"
      ],
      "conclusion": "甲是视频接收方；本次拉取只允许乙向甲发送视频。若是甲要向乙发自己的视频，应查一对一推送；若是服务器提供其保存的文件，应查从服务器拉取录像。",
      "normative_strength": "拉取私呼对视频方向的限定；相邻程序只用于辨别对象。",
      "limitations": [
        "乙端提供视频并不限定其必须是摄像头实况；请求经过服务器不能证明视频由服务器提供。"
      ],
