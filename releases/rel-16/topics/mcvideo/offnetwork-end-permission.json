{
  "topic_id": "r16-mcvideo-offnetwork-end-permission",
  "release": 16,
  "standard_stage": 2,
  "state": "draft",
  "title": "离网 MCVideo 组里，甲发了发送许可释放消息，能说明它此前获准并传过视频吗？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-23.281-v16.4.0",
  "common_conditions": [
    "3GPP TS 23.281 V16.4.0（Release 16，Stage 2）的离网 MCVideo 传输控制。"
  ],
  "condition_rule": "读取离网 MCVideo 信息流表即可解释字段及允许的传送方式，不要求先找到某组的建立、申请或收件记录。若要解释 §7.7.2.6 的具体举例，才结合已建立的离网组通信、参与端已申请自己的发送许可等前提，并按相应步骤另查是否在发、是否收到通知、原申请是否待决。",
  "claims": [
    {
      "id": "release-does-not-prove-grant-or-media",
      "title": "离网 MCVideo 组已建、参与端已申请自己的发送许可时，单仲裁或自仲裁下发出释放并不证明本次获准、已发视频",
      "conditions": [
        "离网 MCVideo 组通信已建立，参与端已请求发送许可，可能已获准；程序说明该端已发现仲裁者。"
      ],
      "conclusion": "离网 MCVideo 参与端检测到仲裁者，不表示本次申请获准。释放消息表示传输结束和释放许可，程序的两个前提是离网 MCVideo 组通信已建立、该端已申请自己的发送许可；不要求本次申请已经获准；是否获准、此前实际发过视频，各需另有依据。",
      "normative_strength": "适用范围、前提中的可能性与消息语义，不能变成事后事实。",
      "limitations": [
        "仅见释放时不把“未证实获准、未证实已发”改写成“被拒、未发”。此处不规定要获取哪一种日志或哪条单独的授予报文。"
      ],
