  "claims": [
    {
      "id": "eligible-group",
      "title": "离网 MCVideo 发起紧急或迫切危险组通信：可预配指定组，也可预配在所选组采用相应行为",
      "conditions": [
        "准备发起其中一种组通信；预配置与本次紧急或迫切危险的类别相符。"
      ],
      "conclusion": "发起端使用预先指定的相应组，或其客户端已预配在当前所选组采用相应行为。",
      "normative_strength": "两条替代的预配置途径，不要求两者同时具备。",
      "limitations": [
        "已选某组不等于已配置它能采用相应行为。"
      ],
