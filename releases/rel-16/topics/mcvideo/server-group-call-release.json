  "common_conditions": [
    "同一 MC 系统内，一场在网 MCVideo 预安排组呼或聊天组呼正在进行；本文只比较服务器发起的整场释放。"
  ],
  "condition_rule": "各声明继承共同条件；接收端响应限已收到释放请求时。不要跨用两种组呼的应答规则或归属说明。",
  "claims": [
    {
      "id": "applicable-condition",
      "title": "同一 MC 系统内的在网 MCVideo 预安排或聊天组呼：至少一个适用的终止条件满足时，由服务器为所有参与者发起释放",
      "conditions": [
        "呼叫仍在进行。须区分本次组呼的模型，并判断该场适用的终止条件。"
      ],
      "conclusion": "预安排组呼的例子包括最后一名或倒数第二名参与者离开、发起人离开、在场的已归属成员不足最低人数；聊天组呼的例子包括聊天时限届满、最后一名参与者或发起人离开。至少一项适用条件成立，服务器发起整场释放。",
      "normative_strength": "两个条款描述触发场景；各自列举的条件并非统一启用、穷尽或须同时满足的清单。",
      "limitations": [
        "一人退出和整场释放是不同程序。仅见发起人离开，不知这场呼叫的适用条件和后续动作时，不能断言整场呼叫已经释放。"
      ],
