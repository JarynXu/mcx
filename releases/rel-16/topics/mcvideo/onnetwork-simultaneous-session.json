  "common_conditions": [
    "Release 16，在网 MCVideo。结论限定于 TS 23.281 V16.4.0 §7.11 的 Stage 2 呼叫能力，不移用于离网仲裁。"
  ],
  "condition_rule": "每条声明同时继承共用范围和本条条件。多个已归属组有活动呼叫只用于解释同时来邀，不是所有并发会话的必要条件。",
  "claims": [
    {
      "id": "session-and-dialogs",
      "title": "在网处理多场 MCVideo 呼叫时，端与服务器可用并发会话；客户端也可用多个对话并行处理",
      "conditions": [
        "区分客户端参与并发会话的途径与多对话并行处理这一能力。"
      ],
      "conclusion": "采用并发会话时，客户端可以通过邀请、加入或接受多场 MCVideo 呼叫，或通过归属一个组而参与。仅知几场呼叫同时进行，不能确定本次怎样组织它们。",
      "normative_strength": "端与服务器可以采用，客户端也可以用多个对话，并非规定每次必须采用并发会话。",
      "limitations": [
        "不要求两种方式在整台客户端上互斥；不规定一个并发会话内部使用几个对话，也不能由来电数倒推出会话数。"
      ],
