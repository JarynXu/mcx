{
  "topic_id": "r16-mcvideo-offnetwork-capability-discovery",
  "release": 16,
  "standard_stage": 2,
  "state": "draft",
  "title": "离网 MCVideo：谁会通告终端能力，谁会回答问询？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-23.281-v16.4.0",
  "common_conditions": [
    "3GPP TS 23.281 V16.4.0，Release 16，Stage 2；同一 MCVideo 组的成员之间离网共享视频能力信息。"
  ],
  "condition_rule": "问询总则适用于组内其他成员。组内筛选问询使用组的直连预配与映射；定向问询另须满足目标客户端直连信息的预配和已在附近发现该目标。",
  "claims": [
    {
      "id": "receive-periodic-group-announcement",
      "title": "不必先问，同组客户端可定期通告自己的能力",
      "conditions": [
        "参与客户端属于同一 MCVideo 组；通告方已预配该组的 ProSe 直连通信信息及该组到 ProSe 二层组 ID 的映射。"
      ],
      "conclusion": "每个客户端定期向该组通告自己的能力；收到通告的其他组员缓存发送方的在场信息、能力信息及随附资料，已有资料则更新。",
      "normative_strength": "定期程序的前提和接收步骤。",
      "limitations": [
        "收到此通告并不要求此前发出过能力请求。"
      ],
