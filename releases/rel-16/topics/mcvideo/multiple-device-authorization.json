  "common_conditions": [
    "解释 3GPP TS 23.281 V16.4.0（Release 16，Stage 2）中 MCVideo 用户的身份认证与业务授权。"
  ],
  "condition_rule": "每条声明继承共同条件。两台终端的用户相同且另一终端已有 MCVideo 业务授权，是 §7.13 第二段的条件，不是通用身份认证的前提。",
  "claims": [
    {
      "id": "authentication-before-service-authorization",
      "title": "单域 MCVideo 流程中，客户端利用用户身份认证结果，与服务器办理业务授权",
      "conditions": [
        "区分 §7.12 高层流程的两个步骤。"
      ],
      "conclusion": "先按通用 MC 业务程序认证用户；随后 MCVideo 客户端与 MCVideo 服务器办理该用户的 MCVideo 业务授权。仅有认证成功记录，不能认定业务已获准。",
      "normative_strength": "编号步骤 2 使用步骤 1 的结果，两步确认的事项不同。",
      "limitations": [
        "不指定认证技术、凭据种类或是否须由用户重新输入凭据。"
      ],
