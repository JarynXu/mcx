  "common_conditions": [
    "TS 23.281 V16.4.0（Rel-16，Stage 2）。甲向乙发起离网一对一自动私呼；乙已指定其私呼客户端；两端同属一个 ProSe 发现组且均支持 ProSe 一对一直连；甲端已通过 ProSe 发现程序发现附近与乙关联的乙端。"
  ],
  "condition_rule": "各项继承全部共同前提；成功呈现与失败处理分别说明，不能把后一步当作此前动作的证据。",
  "claims": [
    {
      "id": "discovery-and-designation",
      "title": "离网自动私呼要求发现与指定；接收端自查，主叫如何识别指定端仍待研究",
      "conditions": [
        "甲已向乙发起离网自动私呼，乙已指定接收私呼的客户端。"
      ],
      "conclusion": "两端同组且能一对一直连；甲端已通过 ProSe 发现程序发现附近与乙关联的客户端。接收端收到含自动启动指示的请求后自查是否为指定端，甲端如何认定指定端为 FFS。",
      "normative_strength": "前提 1–4、步骤 2 与编者注各回答不同的问题。",
      "limitations": [
        "自动流程没有把事先指定限于多端登录。仅从其他途径知道乙端地址，不满足 ProSe 发现前提。"
      ],
