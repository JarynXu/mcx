  "common_conditions": [
    "3GPP TS 23.281 V16.4.0，Release 16，Stage 2；在网 MCVideo 主叫向服务器推送视频、由服务器录成文件。"
  ],
  "condition_rule": "每条声明继承上述范围，再按条件区分接受、传流、结束和可选通知；涉及其他程序的内容只用于辨别方向。",
  "claims": [
    {
      "id": "admit-server-recording-push",
      "title": "服务准入与向服务器推送的授权分别检查",
      "conditions": [
        "主叫客户端向 MCVideo 服务器发起录制推送。"
      ],
      "conclusion": "主叫用户已通过认证且获准使用 MCVideo 服务，客户端已注册。请求必带主叫的 MCVideo ID 和 SDP 媒体提议；所请求的录制时长和应用优先级是可选项。服务器还要检查客户端是否有权向它推送视频。",
      "normative_strength": "流程前提、步骤 1–2 及请求表的必需或可选字段。",
      "limitations": [
        "已有业务授权和注册并不能代替本次推送权限检查。"
      ],
