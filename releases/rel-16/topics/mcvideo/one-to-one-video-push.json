  "common_conditions": [
    "TS 23.281 V16.4.0（Release 16，Stage 2）的在网一对一视频推送；甲指源用户和主叫，乙指目标用户和被叫。"
  ],
  "condition_rule": "推送正常路径的不同事件各依本条条件判断；成功及完成不是所有声明的共同前提。",
  "claims": [
    {
      "id": "source-initiates-one-way-video",
      "title": "本次推送只允许主叫向被叫发视频",
      "conditions": [
        "甲从自己的客户端发起在网一对一视频推送，乙是目标用户；远程发起只用于比较。"
      ],
      "conclusion": "甲端经授权用户可手动发起，或由甲端经授权用户设置的条件自动触发。本次私呼只允许甲向乙发送视频。与之相对，丙可以另发远程推送请求；源端接受该请求后会复用甲乙之间的一对一建呼。",
      "normative_strength": "Stage 2 业务定义、建呼前提及远程程序对照。",
      "limitations": [
        "乙应答不产生反向发视频的资格；源端自动触发不等于有远程请求，不能从甲乙之间的建呼单独还原丙是否参与。"
      ],
