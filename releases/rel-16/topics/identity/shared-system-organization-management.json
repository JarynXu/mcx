{
  "topic_id": "r16-identity-shared-system-organization-management",
  "release": 16,
  "standard_stage": 1,
  "state": "draft",
  "title": "多个任务关键组织共用 MCX 系统：管理员能看什么、改什么？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-22.280-v16.8.0",
  "condition_rule": "每条声明继承共同条件，再按组织、个人、操作对象和可见信息分别判断。",
  "common_conditions": [
    "3GPP TS 22.280 V16.8.0，Release 16，Stage 1；讨论多个任务关键组织使用同一 MCX 业务系统中的管理、安全管理和运行可见性。"
  ],
  "claims": [
    {
      "id": "same-system-separate-organizations",
      "title": "同一个 MCX 系统可支持各有用户与业务组的多个组织",
      "conditions": [
        "判断同一套 MCX 业务系统能否服务多个任务关键组织。"
      ],
      "conclusion": "MCX 业务须能在同一个 MCX 业务系统内支持多个任务关键组织，每个组织各有自己的 MCX 用户和 MCX 业务组。",
      "normative_strength": "R-5.16.2-001：shall be able to support。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 R-5.16.2-001"
          ],
          "printed_pages": [
            26
          ]
        }
      ],
      "limitations": [
        "不要求任一部署一定由多家组织使用；不推出哪个组织可查看其他组织的参数、用户或组，也不规定租户或数据拓扑。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "organizations-designate-and-manage-administrators",
      "title": "组织可指定、增删管理员并改变授权",
      "conditions": [
        "任务关键组织要指定或管理有业务管理权限的 MCX 业务管理员。"
      ],
      "conclusion": "MCX 业务须提供办法让组织指定和管理业务管理员，包括增设、撤销管理员及变更其授权等操作。相关管理权限包括管理用户、组、其他 MCX 业务管理员、安全控制及其他影响任务的参数，例如授权和优先级。",
      "normative_strength": "R-5.16.2-002：shall provide a means。增设、撤销及变更授权属于所说的管理员管理；授权和优先级是影响任务的业务参数示例。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 R-5.16.2-002"
          ],
          "printed_pages": [
            26
          ]
        }
      ],
      "limitations": [
        "不自动授予每位管理员所有权限，也不规定授权界面、角色模型或审批步骤。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "separate-organization-management-parameters",
      "title": "组织间管理和安全管理参数须有效分隔，除非相关组织授权",
      "conditions": [
        "多个任务关键组织共享 MCX 业务系统，判断这些组织的管理与安全管理参数边界。"
      ],
      "conclusion": "为保护组织的运行隐私，MCX 业务须有效分隔这些组织的管理和安全管理参数，例如密钥；相关任务关键组织已授权的情形是例外。",
      "normative_strength": "R-5.16.2-003：shall protect；例外限定为相关组织授权。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 R-5.16.2-003"
          ],
          "printed_pages": [
            27
          ]
        }
      ],
      "limitations": [
        "不设每次读写的审批形式；组织层例外不代替对个人的明确授权，不等于隔断所有业务互通。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "individual-explicit-authorization",
      "title": "组织内外的人未经相应组织明确授权，不能查看或操纵其参数",
      "conditions": [
        "判断个人能否查看或操纵一个任务关键组织的管理或安全管理参数。"
      ],
      "conclusion": "MCX 业务须防止未获该组织明确授权的人查看和操纵这些参数，不论当事人在该组织之内或之外。",
      "normative_strength": "R-5.16.2-004：shall protect；判断个人要看相应组织是否明确授权。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 R-5.16.2-004"
          ],
          "printed_pages": [
            27
          ]
        }
      ],
      "limitations": [
        "组织成员身份、管理员称谓、另一组织的授权或组织级共享不能单独证明个人获准。条文不规定授权的具体记录和发放机制。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "organizations-can-share-subsets",
      "title": "业务须让组织能向其他组织共享参数子集",
      "conditions": [
        "任务关键组织要向其他任务关键组织共享它的管理或安全参数子集。"
      ],
      "conclusion": "MCX 业务须提供手段，让任务关键组织可以把其管理及安全参数的子集与其他任务关键组织共享。",
      "normative_strength": "R-5.16.2-005：shall provide a means；may share 描述组织可以选择共享。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 R-5.16.2-005"
          ],
          "printed_pages": [
            27
          ]
        },
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.2 NOTE following R-5.16.2-005"
          ],
          "printed_pages": [
            27
          ]
        }
      ],
      "limitations": [
        "不要求必分享或自动披露，不证明实际选取了哪些参数，也不从已共享推断所有个人有权查看或修改。附注说明保护运行安全仍允许受组织控制的终端与用户互通，不给新的访问权。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "associated-administrator-can-see-operational-status",
      "title": "与组织关联的管理员须有办法查看业务运行状态",
      "conditions": [
        "MCX 业务管理员与一个任务关键组织相关联；判断其能否了解业务运行状态。"
      ],
      "conclusion": "MCX 业务须提供这名管理员查看业务运行状态的办法。自然灾害是原文举例，不是触发前提。",
      "normative_strength": "R-5.16.3-001：shall provide a means。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.16.3 R-5.16.3-001"
          ],
          "printed_pages": [
            27
          ]
        }
      ],
      "limitations": [
        "不规定状态项目、可见数据的具体范围、刷新方式或页面；不等于可查看或操纵另一组织的管理和安全管理参数。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    }
  ],
