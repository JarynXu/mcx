  "common_conditions": [
    "3GPP TS 23.280 V16.7.0、Release 16、Stage 2，在网。F 指当前讨论的一个功能别名；控制方指控制 F 的 MC 业务服务器，订方指 MC 业务服务器或 LMS。"
  ],
  "condition_rule": "逐条叠加。程序前提仅用于相应程序；已识别信息流的字段判读不要求先查齐现场流程前提。",
  "claims": [
    {
      "id": "subscription",
      "title": "在网 MC 业务服务器或 LMS 向别名控制方订一次或持续的使用者名单通知，成功后知道什么？",
      "conditions": [
        "考察按 F 订阅已激活用户名单。图示的订阅程序要求控制 F 的 MC 业务服务器持有名单；没有规定该名单非空。若只核已识别的信息流表，按该表的方向与必填项判断。"
      ],
      "conclusion": "业务服务器或 LMS 向控制 F 的 MC 业务服务器发送订阅请求，F 与订阅类型（一次通知或持续通知）均必带；少类型不能按某个默认值解释。控制方向订方回 F 及该次订阅的成功或失败。成功仅指订阅请求，不是使用者清单、用户激活授权或实际首报。",
      "normative_strength": "表10.13.2.11-1、12-1各列两项 M。§10.13.10.2 给出持有名单的前提及请求、答复两步。",
      "limitations": [
        "本程序未列对订方另做用户主动查询那样的权限检查，不能反说订阅普遍免授权。未规定首份名单立即到达或一次性订阅何时自动拆除。"
      ],
