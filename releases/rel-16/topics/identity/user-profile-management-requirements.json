{
  "topic_id": "r16-identity-user-profile-management-requirements",
  "release": 16,
  "standard_stage": 1,
  "state": "draft",
  "title": "用户正在用的配置档能改吗？谁指定何时安装，传送时要保护什么？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-22.280-v16.8.0",
  "condition_rule": "各声明继承在网和业务适用范围。使用中修改、指定安装和传送保护分别判断，不构成一次更新的先后步骤。",
  "common_conditions": [
    "TS 22.280 V16.8.0（Release 16，Stage 1）第 6 章限于在网使用。规范性表 A.1、B.1、C.1 分别为 MCPTT、MCVideo、MCData 列出 §6.10 的四项要求。"
  ],
  "claims": [
