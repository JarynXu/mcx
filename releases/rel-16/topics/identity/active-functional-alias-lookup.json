  "common_conditions": [
    "3GPP TS 23.280 V16.7.0，Release 16，Stage 2；限在网的 MC 业务客户端与业务服务器。正常结果的判读以查询者获准并收到含结果的响应作为前提。"
  ],
  "condition_rule": "继承在网范围；根据用户查询或使用情况查询选择目标字段和结果，不交换两种 Null 的指向。",
  "claims": [
    {
      "id": "usage-query-selector-and-authorization",
      "title": "按别名找启用者时的请求与授权",
      "conditions": [
        "目标是查询一个或多个功能别名当前由哪些业务用户启用。"
      ],
      "conclusion": "发起人的客户端向 MC 业务服务器发使用情况查询。请求中查询者自己的 MC 业务 ID 与待查的一个或多个功能别名分别必带。服务器检查该业务用户是否有权执行查询；获准才按别名检索启用者，向客户端返回其信息。",
      "normative_strength": "§10.13.7 允许获授权者查询；表 10.13.2.1a-1 的两项均为 M；图的步骤 2 以授权为检索条件。",
      "limitations": [
        "不要求预先给出候选启用者的 ID；所引流程不指定授权失败的协议码。"
      ],
