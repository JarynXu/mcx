  "common_conditions": [
    "同一 MC 系统内，讨论另一 MC 业务用户已在使用的功能别名。"
  ],
  "condition_rule": "提议、发出请求、请求获准、收到响应及收到撤销通知需分别判断；不将获准预置为拒绝分支的条件。",
  "claims": [
    {
      "id": "offer-is-not-result",
      "title": "同一 MC 系统内，甲在激活时得知乙所用功能别名可接管，不等于甲申请获准或乙已被撤销",
      "conditions": [
        "同一 MC 系统内，讨论另一 MC 业务用户已在使用的功能别名。",
        "甲端已执行激活程序；甲知道哪些别名在用但可接管。"
      ],
      "conclusion": "提议只表明可以申请；甲决定接管后，由甲端另行发出接管请求，服务器仍要检查冲突。",
      "normative_strength": "引言说可能获提议；前提与步骤 1–3 将获提议、决定、申请和获准后撤销区分开。",
      "limitations": [
        "没有接管结果记录不能把它填成已接受或已拒绝。"
      ],
