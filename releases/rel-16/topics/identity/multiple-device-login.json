      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "notify-already-logged-on-elsewhere",
      "title": "另一台已有登录时通知同一用户",
      "conditions": [
        "在网使用。同一 MCX 用户已经在另一台 MCX 终端上登录。"
      ],
      "conclusion": "MCX 业务须向该用户提供通知。",
      "normative_strength": "R-6.11-001：shall provide。",
      "source_references": [
