  "claims": [
    {
      "id": "concurrent-login",
      "title": "同一用户可同时登录多台终端",
      "conditions": [
        "在网、离网共用要求。同一 MCX 用户使用多台 MCX 终端。"
      ],
      "conclusion": "MCX 业务须允许该用户同时登录多台 MCX 终端。",
      "normative_strength": "R-5.10-001：shall allow。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.10 R-5.10-001"
          ],
          "printed_pages": [
            24
          ]
        }
      ],
      "limitations": [
        "不等于同时登录数量不限，也不证明某一次新增登录获准。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "per-service-limit",
      "title": "管理员可按业务限制同时登录数量",
      "conditions": [
        "在网、离网共用要求。判断管理员能否限制用户同时登录多台 MCX 终端的数量。"
      ],
      "conclusion": "MCX 业务须能让业务管理员按 MC 业务限制用户同时登录的终端数量。",
      "normative_strength": "R-5.10-001a：shall be able to allow，要求提供限制数量的能力，不要求管理员一定设置上限。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.10 R-5.10-001a"
          ],
          "printed_pages": [
            24
          ]
        }
      ],
      "limitations": [
        "没有统一数值或默认值，不指定达到上限时拒绝新登录、让旧登录退出或返回某个响应。"
      ],
      "verification": {
        "original_clauses_checked": true,
        "independent_source_review": false,
        "independent_usage_acceptance": false
      }
    },
    {
      "id": "separate-login-on-each-ue",
      "title": "用户须在每台终端上分别登录",
      "conditions": [
        "在网、离网共用要求。同一用户要登录多台 MCX 终端。"
      ],
      "conclusion": "MCX 业务须确保该用户在每台 MCX 终端上分别登录。",
      "normative_strength": "R-5.10-002：shall ensure。",
      "source_references": [
        {
          "source_id": "3gpp-ts-22.280-v16.8.0",
          "clauses": [
            "5.10 R-5.10-002"
          ],
          "printed_pages": [
            24
          ]
        }
      ],
      "limitations": [
