  "common_conditions": [
    "Release 16 的公共 MC Stage 2 流程；对象是 MC 业务客户端与服务器之间的一项已有预建立会话。"
  ],
  "condition_rule": "各声明继承共同条件。客户端发起修改的示例不限制谁可发起；是否检查、是否要再次发起候选对更新分别按需要判断。两种释放发起方向不叠加。",
  "claims": [
    {
      "id": "modify-request-response",
      "title": "客户端发起预建立会话修改时按需收集候选；服务器执行所需业务控制、取得所需媒体参数和候选后发送首次响应",
      "conditions": [
        "§10.3.2.3 的客户端发起示例，终端的 MC 业务客户端要修改一项已有的预建立会话。"
      ],
      "conclusion": "客户端需要时收集 ICE 候选，然后向 MC 业务服务器发修改请求。服务器执行必要的业务控制，取得所需媒体参数，收集所需 ICE 候选，向客户端发送修改响应。",
      "normative_strength": "步骤 1 的候选收集按需；步骤 3 的参数和候选也是按需要取得。通过服务器的媒体分发功能取得参数只是例子。",
      "limitations": [
        "第一次响应是对步骤 2 的回复，不是对后来某次候选对更新的接受。"
      ],
