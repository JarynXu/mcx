{
  "topic_id": "r16-bearers-offnetwork-direct-path-switching",
  "release": 16,
  "standard_stage": 1,
  "state": "draft",
  "title": "MCX 终端什么时候能自动切到离网直连？有网络覆盖时，谁能手动切？",
  "source_catalog": "../../sources.json",
  "source_id": "3gpp-ts-22.280-v16.8.0",
  "condition_rule": "按覆盖状况、用户与终端资格区分自动和手动切换；通信中断只针对同一次通信的连接在在网与对端离网直连之间转换。",
  "common_conditions": [
    "TS 22.280 V16.8.0（Release 16，Stage 1）第 7 章面向离网使用。§7.13 涉及检测到无覆盖、在覆盖内或在覆盖内外的情形，并区分在网与离网直连之间的转换；逐项判断。",
    "规范性表 A.1（MCPTT）、B.1（MCVideo）、C.1（MCData）均列出 R-7.13-001 至 R-7.13-005。"
  ],
  "claims": [
    {
      "id": "ue-can-automatically-switch-to-direct-when-out-of-coverage",
      "title": "终端检测到无覆盖时能自动切到 ProSe 直连",
      "conditions": [
        "MCX 终端检测到离网（超出网络覆盖）的情况。"
      ],
      "conclusion": "MCX 终端须具备自动切到 ProSe 直连路径、在该路径上使用 MCX 业务的能力。",
      "normative_strength": "R-7.13-001：shall be capable of 约束终端具备自动切换能力，不是对每次失去覆盖的结果作保证。",
