  "common_conditions": [
    "3GPP TS 23.280 V16.7.0，Release 16，Stage 2，§§10.7.3.5.1–2：MC 业务服务器经应用控制消息用的 MBMS 承载向客户端通告另一条 MBMS 承载。"
  ],
  "condition_rule": "声明继承上述流程范围，并叠加本条所列条件；区分承载通告消息的载体与消息标识的对象。",
  "claims": [
    {
      "id": "known-control-bearer",
      "title": "经 MBMS 通告另一条承载时，应用控制承载须预先建立并已向该客户端通告",
      "conditions": [
        "服务器选择在同一业务区经 MBMS 而非单播通告另一条承载。"
      ],
      "conclusion": "客户端先在已建立且已向它通告的 MBMS 承载上监听应用控制消息。",
      "normative_strength": "单播或 MBMS 是可选途径；预建立、已向客户端通告两项前提属于这里经 MBMS 发送的程序。",
      "limitations": [
        "仅有网络侧已建立控制承载的记录，不能证明已向该客户端通告。"
      ],
