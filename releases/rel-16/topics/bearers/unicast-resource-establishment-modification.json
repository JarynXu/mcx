  "condition_rule": "每项声明继承通用条件，并叠加本项条件。",
  "common_conditions": [
    "3GPP TS 23.280 V16.7.0，Release 16，Stage 2；适用于 MCPTT、MCVideo、MCData 的在网单播资源建立或修改程序。"
  ],
  "claims": [
    {
      "id": "assess-sharing",
      "title": "在网建会需要申请单播网络资源时，服务器评估资源需求和是否共享媒体资源；有并行会话不等于已共享",
      "conditions": [
        "在网建立需要申请网络资源的 MC 业务呼叫或会话。"
      ],
      "conclusion": "客户端请求建立呼叫或会话，业务服务器评估网络资源需求和媒体资源共享，再发带资源请求的会话进展请求；有并行会话时可利用共享能力。",
      "normative_strength": "共享为可选能力；步骤 1–3 区分请求和评估。",
      "limitations": [
        "不能由并发数推出实际分配关系。"
      ],
