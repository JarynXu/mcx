  "condition_rule": "Inherit common_conditions and add claim conditions.",
  "common_conditions": [
    "3GPP TS 23.280 V16.7.0，Release 16，Stage 2 公共 MBMS 暂停通知程序；该程序假定至少一条活动 MBMS 承载。"
  ],
  "claims": [
    {
      "id": "reporter-selection",
      "title": "至少一条 MBMS 承载处于活动状态时，MC 业务服务器可只选广播区内的部分终端上报暂停，选择时须考虑终端位置",
      "conditions": [
        "按暂停通知程序，从 MBMS 广播区内的终端中选择上报者。"
      ],
      "conclusion": "MC 业务服务器可仅要求一部分终端上报。选择子集时须考虑终端位置；由于终端移动，指令可能需要定期更新。指令可随承载通告发送。",
      "normative_strength": "程序假定至少一条活动 MBMS 承载。须考虑位置，不是每次移动均须更新；随通告发送也是可选。",
      "limitations": [
        "不能把已发上报指令当作承载已暂停的证据。"
      ],
