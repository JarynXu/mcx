  ],
  "claims": [
    {
      "id": "floor-idle-taken-sequence-forwarding",
      "title": "Floor Idle 和 Floor Taken 按会话所存序号过滤后再下发",
      "conditions": [
        "参与功能收到目的端正在监听 MBMS 子信道的 Floor Idle 或 Floor Taken。"
      ],
      "conclusion": "初次无序号则保存收到值；已有时仅在收到值较高时更新；这两种情况把 MBMS 出向确认位置为 0 并下发。相同或更低则丢弃，不再下发。",
      "normative_strength": "按会话序号处理和将出向确认位置 0 是 SHALL。",
      "limitations": [
        "不从出向置 0 推断入向未请求确认。"
      ],
