  "common_conditions": [
    "3GPP TS 24.379 V16.14.0，Release 16，Stage 3；MCPTT 客户端接收以预配置组为基础的重组创建或移除通知。"
  ],
  "claims": [
    {
      "id": "notification-and-affiliation",
      "title": "收到预配置组重组的创建或移除通知时，接收端均须回 200，但对本端归属的认定相反",
      "conditions": [
        "MCPTT 客户端收到请求创建或移除预配置组重组的相应通知。"
      ],
      "conclusion": "两种情况下都宜提醒 MCPTT 用户，都必须向 MCPTT 服务器回 200 (OK)。创建时须视本端已归属该重组；移除时须视本端已解除对该重组的归属。",
      "normative_strength": "提醒为 should；回复 200 和认定相应归属状态为 shall。",
      "limitations": [
        "回执不能证明用户看过提示或已参加一次通话。这里是接收通知的客户端，不是创建或移除请求的发起者。"
      ],
