  "common_conditions": [
    "3GPP TS 23.280 V16.7.0，Release 16，Stage 2：单一 MC 业务、无需拓扑隐藏，用户本人显式申请归属伙伴系统定义的一个或多个组。"
  ],
  "claims": [
    {
      "id": "starting-conditions",
      "title": "哪些信息必须已有，哪些只是可能已备妥？",
      "conditions": [
        "按 §10.8.3.2.2 的程序核对开始条件。"
      ],
      "conclusion": "客户端已获配允许归属的组信息或其指针；用户本人显式触发；GMS 已向组定义所在系统的业务服务器订阅归属状态更新。主业务服务器可能已缓存用户归属状态，伙伴业务服务器可能已从 GMS 取得组资料，客户端可能已向伙伴 GMS 表示希望接收组配置更新。",
      "normative_strength": "前提 1、5、6 是所述程序的前提，2、3、4 使用 may。",
      "limitations": [
        "不能把客户端希望得到组配置更新，等同于 GMS 已订阅归属状态更新。已配组信息或指针也不证明用户已归属。"
      ],
