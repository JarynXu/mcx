{
  "topic_id": "r16-mcptt-implicit-affiliation-n2",
  "title": "MCPTT 请求触发隐式归属：同一用户有两台终端，N2 怎么数，哪一条记录会变？",
  "release": 16,
  "standard_stage": 3,
  "state": "draft",
  "source_catalog": "../../sources.json",
