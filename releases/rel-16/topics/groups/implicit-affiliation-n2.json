  "common_conditions": [
    "处理角色为参与 MCPTT 功能；原 SIP 请求明确需要发送 MCPTT 客户端对目标组隐式归属。身份、候选计算、完成和取消分别按各自主条件适用。"
  ],
  "condition_rule": "须在同一用户、对应客户端及原触发请求的上下文中分别核实各条记录；候选、保存、完成及取消不是四个必定顺次发生的事件。",
  "claims": [
    {
      "id": "candidate-at-sending-client",
      "title": "MCPTT 请求触发隐式归属时，候选列表只从受服务用户的发送客户端复制",
      "conditions": [
        "参与 MCPTT 功能收到使发送客户端需隐式归属目标组的 SIP 请求。"
      ],
      "conclusion": "由请求的 MCPTT 信息体内 mcptt-client-id、mcptt-request-uri 分别确定客户端和目标组，由 P-Asserted-Identity 内公共用户身份确定受服务 MCPTT ID。按用户及其下的客户端定位，复制本端列表，将各原组项复制到候选。若原表中目标缺失或其项过期，须为目标新增一项，初态 affiliating，到期时刻为当前时刻加候选有效期。",
      "normative_strength": "识别、复制及满足新增条件时的三项操作为条款要求；用户身份绑定见注 1。",
      "limitations": [
        "另一端有同组记录不排除本端需要新增；本端已有未过期的目标项则第 7b 项不要求再新增或刷新。",
        "有候选记录不等于替换已经执行；初态不是 affiliated。不从头字段单独证明授权、安全实现或呼叫结果。"
      ],
