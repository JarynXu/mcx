  "claims": [
    {
      "id": "grant-state",
      "clause": "10.5.2.3, 10.5.2.8, 10.5.2.10",
      "conditions": [
        "解释授予、空闲或占用通知"
      ],
      "conclusion": "granted表示相应请求获准可传媒体，并含允许发送时长；idle表示无人获授话权；taken表示另一用户获授。收到taken不等于自己获准发送。"
    },
    {
      "id": "release-cancel",
      "clause": "10.5.2.5, 10.5.2.9, 10.5.2.11",
      "conditions": [
        "区分取消请求、释放与撤销"
      ],
      "conclusion": "request cancel针对队列中的话权请求；release表示媒体传输完成并释放话权；revoked撤销当前持有者的话权。它们都不能直接当作全呼叫释放。"
    },
    {
      "id": "queue",
      "clause": "10.5.2.13–14",
      "conditions": [
        "MCPTT服务器和客户端支持话权请求排队"
      ],
      "conclusion": "须支持查询队列位置的信息流；queue position info说明请求已排队及其位置，不是话权授予。"
    },
    {
      "id": "unicast",
      "clause": "10.5.2.15–16",
      "conditions": [
        "停止或恢复指定通信对指定客户端的单播媒体"
      ],
      "conclusion": "stop表示该单播媒体不需再发给指定客户端；resume由话权控制服务器请求恢复向该客户端发送。作用域不是停止整个组呼或撤销所有参与者话权。"
    },
    {
      "id": "iwf-queue-cancel-info-flows-both-directions-by-role",
      "clause": "10.5.1; 10.5.2.1; 10.5.2.5–.7; 10.5.2.12",
      "conditions": [
        "看同一互通话权信息流中排队取消请求、应答、通知及确认，而非某个组或私呼的仲裁算法。"
      ],
      "conclusion": "三类取消信息流及通用确认均列 IWF→MCPTT floor control server 及反向。不能用发送方向替代消息类型或字段角色，server 触发的通知不等于只可 server→IWF。依互通方式和实际消息源/目的解释 MCPTT ID 及相应别名代表 LMR 用户、IWF 或 MCPTT 用户；查规范无需抓包。",
